# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/customersupport

# Redis & Task Queue Configuration
REDIS_URL=redis://redis:6379/0

# Security Configuration
JWT_SECRET=supersecretjwtkeyforlocaldevelopmentonly12345
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=mock-key
LLM_MODEL=gpt-4o-mini

EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=mock-key
EMBEDDING_MODEL=text-embedding-3-small

# CORS and Network Configurations
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Application Settings
ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=10
